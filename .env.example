# Copy to .env (never commit .env)
BASE_URL=https://www.amazon.in

# Account tests (optional). Legacy names PHONE / PASSWORD are still read.
AMAZON_PHONE=
AMAZON_PASSWORD=
# Part of the saved-address name used by the checkout test
AMAZON_ADDRESS_NAME=

# CI: base64 of .auth/amazon-user.json produced by `npm run auth:save`
# AMAZON_STORAGE_STATE_B64=

# What to do when Amazon serves a CAPTCHA: skip (default in CI) | fail (default locally)
# ON_BOT_CHECK=skip
